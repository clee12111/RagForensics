# ── Generation (cross-provider study) ──────────────────────────────
# Anthropic: primary generation (Sonnet 4.6) + reranking experiments (Haiku, removed)
ANTHROPIC_API_KEY=
# OpenAI: query embeddings (text-embedding-3-small) AND cross-provider generation (GPT-5.5)
OPENAI_API_KEY=
# Google: cross-provider generation (Gemini 3.1 flash-lite) AND LLM-judge (Gemini 2.5 Flash)
GOOGLE_API_KEY=

# ── Vector store ───────────────────────────────────────────────────
PINECONE_API_KEY=

# ── Observability (Langfuse Cloud) ─────────────────────────────────
# Self-hosted Docker was the original plan; switched to cloud (local virtualization unavailable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── MCP server ─────────────────────────────────────────────────────
# Bearer token for Streamable HTTP transport (stdio transport bypasses auth — local subprocess)
MCP_BEARER_TOKEN=

# ── Removed / unused ───────────────────────────────────────────────
# VOYAGE_API_KEY — Voyage embeddings abandoned (free tier 3 RPM/10K TPM, unworkable);
#   switched to OpenAI text-embedding-3-small. Kept here as a note; safe to delete.